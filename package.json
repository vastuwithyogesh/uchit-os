    "test:founder-staging": "node --experimental-strip-types scripts/run-founder-pre-remedy-walkthrough.mjs && node --experimental-strip-types --test tests/founder-staging-walkthrough-contract.test.mjs",
    "test:founder-ui-audit": "node --test tests/founder-ui-action-audit.test.mjs",
    "test:founder-ui-redesign": "node --test tests/founder-ui-redesign.test.mjs",
    "test:founder-component-deep-redesign": "node --test tests/founder-component-deep-redesign.test.mjs",
    "test:founder-scorecard": "node --test tests/founder-scorecard.test.mjs",
    "test:founder-flow": "node --test tests/founder-flow.test.mjs",
    "test:unified-leads": "node --test tests/unified-leads-workspace.test.mjs",
    "test:crm-ia": "node --test tests/crm-information-architecture.test.mjs",
    "test:deployment-readiness": "node --test tests/deployment-readiness-contract.test.mjs",
    "pilot:founder": "node --experimental-strip-types scripts/render-founder-pilot.mjs",
    "lint": "tsc --noEmit",
    "test:persistence": "node --experimental-strip-types --test lib/persistence-merge.test.ts",
    "test:payment-migration": "node --experimental-strip-types --test lib/payment-proof-migration.test.ts",
    "test:evaluation": "node --experimental-strip-types --test lib/evaluation-provenance.test.ts",
    "test:release-data": "node --experimental-strip-types --test tests/release-data.test.mjs",
    "backup:state": "node --experimental-strip-types scripts/state-backup.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
