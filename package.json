  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:sites": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/auth-contract.test.mjs tests/case-file-security-contract.test.mjs tests/client-portal-contract.test.mjs tests/payment-proof-security.test.mjs tests/report-artifact-contract.test.mjs tests/report-integrity-v2.test.mjs tests/release-security-contract.test.mjs tests/security-controls.test.mjs",
    "test:release": "pnpm test && pnpm test:lovable-integration && pnpm test:lovable-dry-run && pnpm test:founder-pilot && pnpm test:founder-multifloor && pnpm test:founder-pre-remedy && pnpm test:founder-staging && pnpm test:founder-ui-audit && pnpm test:founder-ui-redesign && pnpm test:founder-component-deep-redesign && pnpm test:founder-scorecard && pnpm test:founder-flow && pnpm test:unified-leads && pnpm test:crm-ia && pnpm test:deployment-readiness && pnpm test:persistence && pnpm test:payment-migration && pnpm test:evaluation && pnpm test:release-data && pnpm lint && pnpm build",
