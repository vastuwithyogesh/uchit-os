    "test:lovable-dry-run": "node --experimental-strip-types --test tests/lovable-integration-dry-run.test.ts",
    "test:founder-pilot": "node --test tests/founder-golden-pilot.test.mjs",
    "test:founder-multifloor": "node --test tests/founder-multifloor-pilot.test.mjs",
