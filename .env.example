DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uchit_vastu"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/uchit_vastu"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# Sites production bindings are configured in .openai/hosting.json as DB and R2.
# This owner secret is server-only, must be at least 32 characters, and must never enter AppState or client responses.
PDF_OWNER_SECRET="replace-with-an-owner-managed-secret-of-at-least-32-characters"

# Disposable loopback development only. Keep both false in every shared or production environment.
UCHIT_VASTU_DEMO_MODE="false"
UCHIT_VASTU_WALKTHROUGH="false"
