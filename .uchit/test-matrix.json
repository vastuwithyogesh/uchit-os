      "commands": ["pnpm test:security", "pnpm test:release"]
    },
    {
      "name": "commercial-payment",
      "pathPrefixes": ["lib/founder-commercial", "lib/payment", "lib/statutory"],
      "commands": ["pnpm test:founder-no-refund", "pnpm test:founder-complimentary-case", "pnpm test:founder-statutory", "pnpm test:release"]
    },
    {
      "name": "founder-flow",
      "pathPrefixes": ["lib/founder-flow", "lib/founder-scorecard", "components/founder", "app/founder/"],
      "commands": ["pnpm test:founder-flow", "pnpm test:founder-scorecard", "pnpm test:reference-parity", "pnpm test:release"]
    },
    {
      "name": "evaluation-methodology",
      "pathPrefixes": ["lib/directional", "lib/elemental", "lib/aou-methodology", "lib/methodology", "lib/evaluation"],
      "commands": ["pnpm test:evaluation", "pnpm test:founder-pilot", "pnpm test:founder-multifloor", "pnpm test:release"]
    },
    {
      "name": "stage-b-remedy",
      "pathPrefixes": ["lib/stage-b", "components/stage-b", "lib/remediation", "components/remediation"],
      "commands": ["pnpm test:stage-b", "pnpm test:section-a", "pnpm test:founder-pre-remedy", "pnpm test:release"]
