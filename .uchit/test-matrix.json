    {
      "name": "report-delivery",
      "pathPrefixes": ["lib/report", "lib/document-delivery", "lib/final-pdf", "app/api/report", "app/api/delivery"],
      "commands": ["pnpm test:delivery", "pnpm test:security", "pnpm test:founder-pilot", "pnpm test:release"]
    },
    {
      "name": "database-persistence",
      "pathPrefixes": ["db/", "prisma/", "lib/persistence"],
      "commands": ["pnpm test:persistence", "pnpm test:payment-migration", "pnpm test:deployment-readiness", "pnpm test:release"]
    },
    {
      "name": "crm-leads",
      "pathPrefixes": ["app/crm", "components/crm", "lib/crm", "components/unified-leads"],
      "commands": ["pnpm test:unified-leads", "pnpm test:crm-ia", "pnpm test:lead-import", "pnpm test:release"]
    }
