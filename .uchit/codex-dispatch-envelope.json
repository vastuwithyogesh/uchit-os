{
  "version": 1,
  "mode": "CONTRACT_ONLY",
  "provider": "CODEX",
  "executionEnabled": false,
  "credentialBindingConfigured": false,
  "requiresFreshClaim": true,
  "requiresIsolatedBranch": true,
  "requiresTaskPacketQualityGate": true,
  "requiresRepositoryReadinessGo": true,
  "allowedRiskClasses": ["R0", "R1"],
  "protectedRiskClasses": ["R2"],
  "prohibitedRiskClasses": ["R3"],
  "requiredEnvelopeFields": [
    "dispatchId",
    "ticketId",
    "taskPacketId",
    "claimId",
    "claimVersion",
    "baseSha",
    "branch",
    "implementerIdentity",
    "riskClass",
    "authorityReferences",
    "readScope",
    "writeScope",
    "protectedWriteScope",
    "forbiddenScope",
    "acceptanceCriteria",
    "requiredTests",
    "stopConditions",
    "governanceSnapshot"
  ],
  "governanceSnapshotMustInclude": [
    "AGENTS.md",
    "PRODUCT_CONSTITUTION.md",
    "ARCHITECTURE_RULES.md",
    "AUTONOMY_POLICY.md",
    "SECURITY_POLICY.md",
    "TESTING_POLICY.md",
    "RELEASE_POLICY.md"
  ],
  "stopConditions": [
    "product or methodology ambiguity",
    "risk escalates to R2 or R3",
    "required write is outside write scope",
    "protected write lacks explicit approval",
    "forbidden scope would be touched",
    "claim lease is stale or lost",
    "branch identity no longer matches claim",
    "required test cannot be executed",
    "security or authorization invariant is uncertain"
  ],
  "forbidden": [
    "direct push to main",
    "scope expansion",
    "risk downgrade",
    "test weakening",
    "secret disclosure",
    "self-review",
    "self-merge",
    "production deployment"
  ]
}
